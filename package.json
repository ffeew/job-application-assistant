{
  "name": "job-application-assistant",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run lint && next build",
    "build:runtime": "node scripts/build-runtime.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:migrate": "node --import tsx scripts/migrate.mts",
    "worker": "node --import tsx scripts/generation-worker.mts",
    "extension:build": "esbuild extension/src/page.ts extension/src/panel.ts extension/src/background.ts --bundle --format=iife --target=chrome116 --tsconfig=tsconfig.json --outdir=extension/dist",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.54",
    "@hookform/resolvers": "^5.9.1",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "ai": "^7.0.127",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "install": "^0.13.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "resend": "^6.32.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/eslint-plugin-query": "5.104.1",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "pino-pretty": "^13.2.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.3",
    "testcontainers": "^12.2.0",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
