# Copy to .env. Generate each password/token independently: openssl rand -hex 32
# Variable reference: README.md#configuration
# URLs below are for host development; Compose supplies internal service URLs.
NODE_ENV=development
# LOG_LEVEL=info

POSTGRES_DB=job_assistant
POSTGRES_USER=job_assistant
POSTGRES_PASSWORD=replace-with-generated-password
# Match the credentials above; URL-encode special characters in this host URL.
# Compose constructs its internal URL safely from the individual fields.
DATABASE_URL=postgresql://job_assistant:replace-with-generated-password@localhost:5432/job_assistant

# Use your public HTTPS origin when deploying through Cloudflare Tunnel.
BETTER_AUTH_SECRET=replace-with-independent-generated-secret
BETTER_AUTH_URL=http://localhost:3000
# Anyone who can reach the server can create an account and use its Groq key.
# Set this to true once your own accounts exist.
# DISABLE_SIGNUP=false
# APP_PORT=3000

# App and worker startup requires the API key, even for non-AI features.
# Get a key from https://console.groq.com/.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Optional: answer drafting and extension form filling use the OpenRouter
# model when both are set, and Groq otherwise (https://openrouter.ai/).
# OPENROUTER_API_KEY=sk-or-your-key
# OPENROUTER_TIER_3_MODEL=openai/gpt-6-luna

LATEX_COMPILER_URL=http://localhost:8080
LATEX_COMPILER_TOKEN=replace-with-independent-generated-token

OCR_SERVICE_URL=http://localhost:8081
OCR_SERVICE_TOKEN=replace-with-independent-generated-token

OBJECT_STORAGE_URL=http://localhost:8333
OBJECT_STORAGE_ACCESS_KEY=job-assistant
OBJECT_STORAGE_SECRET_KEY=replace-with-independent-generated-secret
# OBJECT_STORAGE_BUCKET=job-assistant

# Optional password reset email provider (https://resend.com/).
# Without the API key, email content is written to the server log.
# RESEND_API_KEY=re_your-key
# RESEND_FROM_EMAIL=noreply@yourdomain.com
