# Copy to .env. Generate each password/token independently: openssl rand -hex 32
NODE_ENV=development

# Compose database credentials also determine the host DATABASE_URL below.
POSTGRES_DB=job_assistant
POSTGRES_USER=job_assistant
POSTGRES_PASSWORD=replace-with-generated-password
# Host development and Drizzle CLI URL. Match the credentials above; URL-encode
# special characters. Compose constructs its internal URL safely from these fields.
DATABASE_URL=postgresql://job_assistant:replace-with-generated-password@localhost:5432/job_assistant

# Use your public HTTPS origin when deploying through Cloudflare Tunnel.
# Browser authentication uses the same origin and needs no NEXT_PUBLIC auth URL.
BETTER_AUTH_SECRET=replace-with-independent-generated-secret
BETTER_AUTH_URL=http://localhost:3000
# Compose publishes the app on this loopback host port.
# APP_PORT=3000

# App and worker startup requires both API keys, even for non-AI features.
# Get keys from https://console.groq.com/ and https://console.mistral.ai/.
GROQ_API_KEY=your-groq-api-key
# Resume fitting retries with GROQ_FALLBACK_MODEL if the primary model fails.
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
MISTRAL_API_KEY=your-mistral-api-key

# Host development URL; Compose uses http://latex-compiler:8080 internally.
# App and compiler must share this token (at least 32 characters).
LATEX_COMPILER_URL=http://localhost:8080
LATEX_COMPILER_TOKEN=replace-with-independent-generated-token

# Optional password reset email provider (https://resend.com/).
# Without the API key, email content is logged to the server console.
# With a key, the sender defaults to noreply@example.com unless overridden.
# RESEND_API_KEY=re_your-key
# RESEND_FROM_EMAIL=noreply@yourdomain.com
